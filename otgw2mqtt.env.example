# otgw2mqtt configuration. Copy to otgw2mqtt.env and adjust.
# Read by systemd (EnvironmentFile=) or by the script with --env-file. Plain KEY=VALUE lines only:
# comments must be on their own line (systemd does not support inline comments).

# Identity of the appliance; used for InfluxDB tag 'id', Home Assistant device and default OUT_TOPIC
BOILER_NAME=cvketel
# CRITICAL | ERROR | WARNING | INFO | DEBUG (overridden by -L on the command line)
LOG_LEVEL=INFO

# --- MQTT broker ------------------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=otgw2mqtt
MQTT_PASSWORD=change-me
MQTT_CLIENT_ID=otgw2mqtt

# --- otmonitor --------------------------------------------------------------
# Where otmonitor publishes its events and listens for actions
OTMONITOR_EVENT_TOPIC=events/central_heating/otmonitor
OTMONITOR_ACTION_TOPIC=actions/otmonitor

# Raw OpenTherm message stream (otmonitor relay port, default 7686). Leave OTGW_HOST empty to disable.
# Used to read the thermostat's own control setpoint (ID 1), even while the CS override is active.
OTGW_HOST=localhost
OTGW_PORT=7686

# --- Output -----------------------------------------------------------------
# Sanitized values are published (not retained) to OUT_TOPIC/<name>. Must not be inside OTMONITOR_EVENT_TOPIC.
OUT_TOPIC=otgw2mqtt/cvketel
# Re-publish / re-write unchanged values at most every HEARTBEAT seconds (0 = every message)
HEARTBEAT=60

# --- External outdoor temperature sensor (forwarded to otmonitor 'outside') --
# Leave OUTDOOR_TOPIC empty to disable. OUTDOOR_JSON_KEY may be a dotted path; empty = plain numeric payload.
OUTDOOR_TOPIC=sensors/your/outdoor/sensor/event
OUTDOOR_JSON_KEY=temperature_C

# --- InfluxDB 1.x -----------------------------------------------------------
# Leave INFLUX_HOST empty to disable.
INFLUX_HOST=localhost
INFLUX_PORT=8086
INFLUX_USERNAME=otgw2mqtt
INFLUX_PASSWORD=change-me
INFLUX_DATABASE=sensors
INFLUX_MEASUREMENT=environmental

# --- Home Assistant ---------------------------------------------------------
HA_ENABLED=true
HA_DISCOVERY_PREFIX=homeassistant
# Publish numeric values to MQTT / Home Assistant at most once per HA_UPDATE_INTERVAL seconds (0 = no limit).
# Faster readings are combined into a time-weighted average; slower ones are passed through unmodified.
# InfluxDB always receives every reading.
HA_UPDATE_INTERVAL=10

# --- Control setpoint override ---------------------------------------------
# Allowed range for the control setpoint sent by the override (°C flow temperature), in both modes.
# In relative mode a thermostat request at or below OVERRIDE_MIN means 'off' and is passed through unchanged.
OVERRIDE_MIN=10
OVERRIDE_MAX=55
# Relative mode: the offset added to the thermostat's request is limited to -N..+N °C
OVERRIDE_OFFSET_MAX=10
# Re-send the override to otmonitor this often (seconds) while it is active
OVERRIDE_REFRESH=55
# Hand control back to the thermostat (CS=0) when the service stops cleanly
OVERRIDE_RELEASE_ON_EXIT=true
